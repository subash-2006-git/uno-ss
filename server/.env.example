# Copy to server/.env (never commit the real one) and fill in.
PORT=3001

# Neon connection string. The pooled URL (host contains "-pooler") is best for hosting.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Admin account, created/synced on every server start. Password needs 8+ chars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
